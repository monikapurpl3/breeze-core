# syntax=docker/dockerfile:1
# Self-contained musl bundle for Alpine / Void-musl / OpenWrt. Built on
# Alpine 3.19 ON PURPOSE: its musl 1.2.4 is the floor for OpenWrt 23.05
# (3.20's musl 1.2.5 links pwritev2, which 23.05 lacks). Newer musl systems
# run older-musl binaries fine, so this one bundle covers them all.
# Works for linux/amd64, linux/arm64 and linux/riscv64 (pick with --platform).
# riscv64 MUST override ALPINE_TAG to 3.22 — Alpine publishes no riscv64 image
# before 3.20, and its rust is too old to build pydantic-core before 3.22.
# That bundle therefore carries a newer musl and is NOT
# OpenWrt-23.05-safe, which is fine: riscv64 ships for Alpine / Void-musl.
#
#   docker buildx build --platform linux/amd64 -f packaging/binary/Dockerfile.musl \
#     --build-arg AC_COMMIT=$(git rev-parse --short HEAD) \
#     -o type=local,dest=packaging/out/bundle-musl-amd64 .

ARG ALPINE_TAG=3.19
FROM alpine:${ALPINE_TAG} AS build

# binutils: PyInstaller needs objdump/objcopy to assemble the bundle.
RUN apk add --no-cache python3 py3-pip binutils

# amd64/arm64 get musllinux wheels for everything, so no compiler is needed and
# the image stays small. riscv64 has NO musllinux wheels — pip falls back to
# building from source, which needs a C toolchain *and* Rust (pydantic-core is
# a Rust extension). Gated on an ARG so the common builds don't pay for it.
# zlib-dev is not optional: on an arch with no prebuilt wheel, PyInstaller has to
# compile its own bootloader, and that link fails with "Checking for library z:
# no" without the headers. libffi/openssl dev headers are here for the same
# reason — several deps fall back to a source build when no wheel exists.
ARG WITH_TOOLCHAIN=0
# Which compiler builds PyInstaller's bootloader. Emulated gcc dies with an
# internal compiler error (SIGSEGV in cc1) partway through the bootloader on
# s390x; clang gets through it. Overridable in case the reverse is ever true.
ARG POC_CC=clang
RUN if [ "$WITH_TOOLCHAIN" = "1" ]; then \
      apk add --no-cache build-base python3-dev rust cargo patchelf \
                         zlib-dev libffi-dev openssl-dev clang; \
    fi

WORKDIR /src
COPY requirements.txt .
# Under QEMU every instruction is emulated, so a from-source build is the slow
# path by orders of magnitude. Give cargo/make all the host's threads and drop
# debug info we'd only strip later.
ARG BUILD_JOBS=4
# CARGO_TARGET_DIR is pinned to a fixed path so it can be cache-mounted below:
# pip unpacks each sdist into a randomly-named /tmp directory, so cargo's
# default (<srcdir>/target) is a new path every run and nothing is ever reused.
ENV CARGO_BUILD_JOBS=${BUILD_JOBS} \
    MAKEFLAGS=-j${BUILD_JOBS} \
    RUSTFLAGS="-C debuginfo=0" \
    CARGO_NET_RETRY=5 \
    CARGO_TARGET_DIR=/cargo-target
# BuildKit cache mounts, NOT image layers — they survive between builds and add
# nothing to the final bundle, so `--no-cache-dir` (which was here before) is
# both unnecessary and actively harmful: it threw away every compiled wheel.
# This matters entirely for wheel-less architectures. On amd64/arm64 pip just
# downloads binary wheels and none of it signifies; on riscv64 every dependency
# is compiled, and the first successful build took over two hours — of which
# the Rust compile of pydantic-core was the bulk. With these mounts a repeat
# build reuses the wheels and cargo's artifacts instead of redoing all of it.
# One more subtlety, and it costs an hour when you miss it: PyInstaller ships
# prebuilt bootloaders only for common platform triples, and the ones inside its
# s390x/ppc64le wheels are glibc-only. Installing the wheel therefore looks fine
# and then dies at the very LAST step of the build — "does not include a
# pre-compiled bootloader for your platform" — after every dependency has
# already been compiled. The bootloader has to be built for the real triple,
# which is the other reason WITH_TOOLCHAIN brings gcc and zlib-dev.
#
# `pip install --no-binary pyinstaller` is NOT enough, and fails in the most
# misleading way available: the sdist build never invokes waf, so it produces a
# py3-none-any wheel carrying no bootloader at all, pip reports success, and the
# build dies 200 lines later still looking for Linux-64bit-s390x-musl/run. So
# compile it explicitly — download, run waf, install the tree — which is
# PyInstaller's own documented procedure for an unsupported platform. Note
# `waf distclean all`, not `waf all`: without the configure step waf exits
# "finished successfully" in 13 milliseconds having built nothing at all.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,target=/cargo-target,sharing=locked \
    python3 -m venv /venv \
    && /venv/bin/pip install --upgrade pip \
    && /venv/bin/pip install -r requirements.txt \
    && if [ "$WITH_TOOLCHAIN" = "1" ]; then \
         /venv/bin/pip download --no-binary :all: --no-deps -d /tmp/pyi pyinstaller \
         && tar -xzf /tmp/pyi/pyinstaller-*.tar.gz -C /tmp/pyi \
         && cd /tmp/pyi/pyinstaller-*/bootloader \
         && CC="${POC_CC:-clang}" /venv/bin/python ./waf distclean all \
         && cd .. && /venv/bin/pip install . && cd /src; \
       else \
         /venv/bin/pip install pyinstaller; \
       fi

COPY meow_ac ./meow_ac
COPY static ./static
COPY setup_device.py ./
COPY packaging/binary/launcher.py packaging/binary/breeze-core.spec ./

ARG AC_COMMIT=dev
RUN echo "$AC_COMMIT" > meow_ac/_commit.txt \
    && /venv/bin/pyinstaller --clean --distpath dist breeze-core.spec \
    && ./dist/breeze-core/breeze-core version

FROM scratch AS export
COPY --from=build /src/dist/breeze-core /breeze-core
